[Unit]
Description=StudentsPoint Log Monitor
After=network.target studentspoint-gunicorn.service

[Service]
Type=simple
User=studentspoint
Group=studentspoint
WorkingDirectory=/home/studentspoint/students-point/proyecto/src/backend
Environment="PATH=/home/studentspoint/students-point/proyecto/src/backend/venv/bin"
Environment="DJANGO_SETTINGS_MODULE=studentspoint.settings.prod"
ExecStart=/home/studentspoint/students-point/proyecto/src/backend/venv/bin/python \
          /home/studentspoint/students-point/proyecto/src/backend/monitor_logs.py \
          --interval 60
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

