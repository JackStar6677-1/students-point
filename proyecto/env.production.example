# Configuración de Producción - StudentsPoint
# Copiar a .env y completar con valores reales

# Django
SECRET_KEY=cambia-este-secreto-por-uno-aleatorio-muy-largo-y-seguro
DEBUG=0
DJANGO_SETTINGS_MODULE=studentspoint.settings.prod

# Hosts
ALLOWED_HOSTS=studentspoint.app,www.studentspoint.app
FRONTEND_URL=https://studentspoint.app

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=studentspoint_prod
DB_USER=studentspoint_user
DB_PASSWORD=contraseña-segura-de-base-de-datos
DB_HOST=localhost
DB_PORT=5432

# Redis (Cache & Celery)
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-app
DEFAULT_FROM_EMAIL=StudentsPoint <noreply@studentspoint.app>

# Security
CSRF_TRUSTED_ORIGINS=https://studentspoint.app,https://www.studentspoint.app
CORS_ALLOWED_ORIGINS=https://studentspoint.app,https://www.studentspoint.app

# OAuth Google
GOOGLE_OAUTH_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=tu-client-secret
GOOGLE_REDIRECT_URI=https://studentspoint.app/api/auth/google/callback/web/

# Monitoring (Opcional)
SENTRY_DSN=https://tu-sentry-dsn@sentry.io/proyecto
ALERT_EMAIL=admin@studentspoint.app

# Rate Limiting
THROTTLE_USER_RATE=500/day
THROTTLE_ANON_RATE=50/day
